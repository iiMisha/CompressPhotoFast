<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        tools:context=".ui.MainActivity">

        <!-- Секция: автоматическое сжатие -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAutoCompressionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/auto_compression_toggle"
                android:textSize="16sp"
                android:textColor="@color/on_surface" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAutoCompression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAutoCompressionDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/auto_compression_description"
            android:textSize="13sp"
            android:textColor="@color/on_surface_variant" />

        <!-- Строка раскрытия предупреждения -->
        <LinearLayout
            android:id="@+id/autoCompressionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvWarningTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/warning_card_title"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant" />

            <ImageView
                android:id="@+id/ivExpandArrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_expand_more"
                android:contentDescription="@string/auto_compression_description"
                app:tint="@color/on_surface_variant" />
        </LinearLayout>

        <!-- Сворачиваемая карточка предупреждения -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/warningCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/surface_variant"
            app:strokeWidth="0dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvBackgroundModeWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/background_mode_warning"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenBatterySettings"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingStart="0dp"
                    android:text="@string/warning_open_battery_settings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Секция: режим сохранения -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSaveModeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save_mode_toggle"
                android:textSize="16sp"
                android:textColor="@color/on_surface" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSaveMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSaveModeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/save_mode_description"
            android:textSize="13sp"
            android:textColor="@color/on_surface_variant" />

        <!-- Секция: качество сжатия -->
        <TextView
            android:id="@+id/tvCompressionQualityTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/compression_quality_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/on_surface_variant" />

        <TextView
            android:id="@+id/tvCompressionQualityDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/compression_quality_description"
            android:textSize="13sp"
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/radioGroupQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rbQualityLow"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:insetLeft="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:insetRight="0dp"
                tools:text="Низкое (60%)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rbQualityMedium"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:insetLeft="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:insetRight="0dp"
                tools:text="Среднее (70%)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rbQualityHigh"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:insetLeft="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:insetRight="0dp"
                tools:text="Высокое (85%)" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Секция: разрешение -->
        <TextView
            android:id="@+id/tvResolutionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/resolution_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/on_surface_variant" />

        <TextView
            android:id="@+id/tvResolutionDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/resolution_description"
            android:textSize="13sp"
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/radioGroupResolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rbResolutionOriginal"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:insetLeft="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:insetRight="0dp"
                android:text="@string/resolution_original" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rbResolution2560"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:insetLeft="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:insetRight="0dp"
                android:text="@string/resolution_2560" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rbResolution1920"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:insetLeft="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:insetRight="0dp"
                android:text="@string/resolution_1920" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Кнопка выбора фото -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectPhotos"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/select_photos_button"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
